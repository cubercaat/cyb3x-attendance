# ====== CYB3X DAVOMAT — sozlamalar ======
# Bu faylni .env nomi bilan nusxalab, qiymatlarni to'ldiring.

# Telegram botdan olingan token (@BotFather)
BOT_TOKEN=123456:AAE...replace_me

# Bot username (@siz)
BOT_USERNAME=cyb3xbot

# Super admin Telegram ID (sizning ID — @userinfobot dan oling)
SUPER_ADMIN_ID=0

# Mini app ochiladigan public URL (https). Masalan https://cyb3x.onrender.com
# Bu RP_ID uchun ham ishlatiladi (Face ID / WebAuthn).
PUBLIC_URL=https://example.com

# Server ichki maxfiy kaliti (uzun tasodifiy satr). Tokenlarni imzolaydi.
SECRET_KEY=change_this_to_a_long_random_string_64_chars

# Universitet koordinatalari (ixtiyoriy — faqat super admin tekshiruvi uchun)
# TTPU taxminiy: 41.3480, 69.2910. O'zingiznikiga o'zgartiring.
CAMPUS_LAT=41.3480
CAMPUS_LON=69.2910
# Qabul qilinadigan radius (metr). 30 = faqat auditoriya atrofida.
CAMPUS_RADIUS_M=30

# QR/kod tokeni necha soniya yashaydi (anti-forward). 8 = tavsiya.
TOKEN_TTL_SECONDS=8

# Davomat necha kun saqlanadi, keyin avtomatik 0 ga tushadi (talaba/Face ID saqlanadi)
RETENTION_DAYS=2
CLEANUP_EVERY_HOURS=6

# Shared hosting (cPanel) bo'lsa true qiling (webhook). VPS/Render da false (polling).
USE_WEBHOOK=false

# Server porti
PORT=8080

# Ma'lumotlar bazasi
DATABASE_URL=sqlite+aiosqlite:///./cyb3x.db
